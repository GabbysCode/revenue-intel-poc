# =============================================================================
# RevIntel — backend environment
# Copy to backend/.env and fill in your values. The file is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Databricks Genie (powers the natural-language assistant)
# -----------------------------------------------------------------------------
# Without these set, the NLP panel transparently falls back to the local
# DuckDB analytics engine — every other page works fine offline.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_personal_access_token
GENIE_SPACE_ID=your_genie_space_id

# -----------------------------------------------------------------------------
# Tellr (ai-slide-generator) — exec deck export from the dashboard
# -----------------------------------------------------------------------------
# TELLR_BASE_URL is the base URL of your deployed ai-slide-generator
# Databricks App, e.g. https://<app-slug>-<workspace-id>.<region>.databricksapps.com
TELLR_BASE_URL=

# Pattern detection precedence (per request) is A → C → B:
#
# Pattern A — Same-workspace Databricks App → Tellr (RECOMMENDED for prod).
#   Triggered automatically when the inbound request carries an
#   `x-forwarded-email` header (i.e. RevIntel is itself a Databricks App in
#   the same workspace as Tellr). NO TOKEN VARS NEEDED — the Apps proxy
#   strips any caller-supplied auth and re-injects identity headers itself.
#
# Pattern C — Cross-workspace deploy (service-principal OAuth M2M).
#   Used when RevIntel is a Databricks App in a DIFFERENT workspace from
#   Tellr. Create a service principal in the Tellr workspace, grant it
#   app-level access on the Tellr app, and supply its OAuth client secret
#   here. Tokens auto-refresh in-process — no human in the loop.
TELLR_SP_CLIENT_ID=
TELLR_SP_CLIENT_SECRET=
# Optional: override the OIDC token endpoint host. Defaults to the host
# part of TELLR_BASE_URL, which is correct unless Tellr is behind a custom
# domain that differs from its workspace's databricksapps.com hostname.
TELLR_WORKSPACE_HOST=

# Pattern B — External caller with a static OAuth U2M bearer (LOCAL DEV ONLY).
#   Tellr is a Databricks App and rejects PATs (dapi…). Mint a U2M token with:
#       databricks auth login --host <tellr-workspace-host> --profile tellr
#       databricks auth token -p tellr | jq -r .access_token
#   Tokens live ~1 hour — re-mint and restart the backend if you see 401s.
#   For deployed apps prefer Pattern A or C; Pattern B has no auto-refresh.
DATABRICKS_OAUTH_TOKEN=

# Optional alias kept for backwards compatibility — DATABRICKS_OAUTH_TOKEN takes precedence.
TELLR_OAUTH_TOKEN=
