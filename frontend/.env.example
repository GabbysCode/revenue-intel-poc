# =============================================================================
# RevIntel — frontend environment (optional)
# Copy to frontend/.env.local. The file is gitignored.
# =============================================================================

# Override the upstream backend URL the Next.js dev server proxies to.
# Defaults to http://127.0.0.1:8000 when unset. Use http://backend:8000 in Docker Compose.
# BACKEND_UPSTREAM=http://127.0.0.1:8000

# Optional deep link to your Genie room — shown as "Open Databricks Genie room →"
# on the login screen. Leave unset to hide the link entirely.
# NEXT_PUBLIC_GENIE_ROOM_URL=https://<workspace>/genie/rooms/<space-id>?o=<org-id>

# Optional gate on the demo login. When set, users must supply this code to sign in.
# NEXT_PUBLIC_DEMO_ACCESS_CODE=
